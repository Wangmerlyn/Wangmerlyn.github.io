---
import { projectCategories } from "@/data/projects";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Side projects, competitions, and open-source contributions by Siyuan Wang.",
	title: "Projects",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-10">Projects & Open Source</h1>
	<div class="prose prose-sm prose-cactus max-w-none space-y-10">
		{projectCategories.map((category) => (
			<section class="space-y-4">
				<h2 class="text-lg font-semibold text-accent">{category.title}</h2>
				<div class="mt-2 space-y-4">
					{category.items.map((item) => (
						<article class="rounded-lg border border-zinc-200/70 p-4 shadow-sm dark:border-zinc-700/70">
							<div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between sm:gap-3">
								<div class="flex items-baseline gap-2">
									{item.link ? (
										<a
											class="cactus-link text-base font-semibold"
											href={item.link}
											rel="noopener noreferrer"
											target="_blank"
										>
											{item.title}
										</a>
									) : (
										<span class="text-base font-semibold">{item.title}</span>
									)}
									{item.period && (
										<span class="text-xs uppercase tracking-wide text-zinc-600 dark:text-zinc-300">
											{item.period}
										</span>
									)}
								</div>
								{item.role && (
									<span class="text-xs uppercase tracking-wide text-zinc-500 dark:text-zinc-400">
										{item.role}
										{item.org ? ` · ${item.org}` : ""}
									</span>
								)}
								</div>
								<p class="mt-2 text-sm leading-relaxed text-zinc-700 dark:text-zinc-200">
									{item.description}
								</p>
								{item.prs && item.prs.length > 0 && (
									<details class="mt-2 rounded border border-zinc-200/70 bg-zinc-50 px-3 py-2 text-sm dark:border-zinc-700/70 dark:bg-zinc-800/60">
									<summary class="cursor-pointer font-semibold text-accent">
										Pull Requests
									</summary>
									<ul class="mt-2 space-y-1" role="list">
										{item.prs.map((pr) => (
											<li>
												<a class="cactus-link" href={pr.url} rel="noopener noreferrer" target="_blank">
													{pr.label}
												</a>
											</li>
										))}
									</ul>
								</details>
							)}
								{item.tags && item.tags.length > 0 && (
									<ul class="mt-3 flex flex-wrap gap-2" role="list">
										{item.tags.map((tag) => (
											<li class="rounded-full border border-zinc-300 px-2 py-0.5 text-[11px] uppercase tracking-wide dark:border-zinc-600">
												{tag}
											</li>
										))}
									</ul>
								)}
						</article>
					))}
				</div>
			</section>
		))}
	</div>
</PageLayout>
